# Copy to .env and fill in as needed. Demo runs with no keys.

WASSIST_API_KEY=
WASSIST_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: OpenAI language layer (intent, purchase reports, lines, shop URLs).
# Runtime lists models and picks smallest Luna, else cheapest mini.
# Without it every line comes from deterministic templates. Verdicts never use it.
# Web cards scrape og:image from the retailer page itself (no stock-photo APIs).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional / reserved (Twilio / Meta stubs; xAI polish)
WHATSAPP_VERIFY_TOKEN=
TWILIO_AUTH_TOKEN=
XAI_API_KEY=
