# Copy to .env and fill in as needed. Demo runs with no keys.

WASSIST_API_KEY=
WASSIST_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: live photo search when the catalogue is thin for a garment+colour.
# Without it Miranda falls back to keyless Openverse, then Wikimedia Commons.
PEXELS_API_KEY=

# Optional / reserved (Twilio / Meta stubs; xAI polish)
WHATSAPP_VERIFY_TOKEN=
TWILIO_AUTH_TOKEN=
XAI_API_KEY=
